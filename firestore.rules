rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados do book-escola: só quem abriu o app (sessão anônima do Firebase) lê e grava.
    match /escolas/{escolaId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /escolas/{escolaId} {
      allow read, write: if request.auth != null;
    }
    // Todo o resto do banco fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
